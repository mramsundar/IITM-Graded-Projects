{
    "version": "1.0",
    "target": "claim_status",
    "features": [
        {
            "name": "age",
            "type": "int8",
            "required": true,
            "constraints": {
                "min_value": 0,
                "max_value": 120
            }
        },
        {
            "name": "gender",
            "type": "category",
            "required": true,
            "constraints": {
                "allowed_values": [
                    "M",
                    "F"
                ]
            }
        },
        {
            "name": "city",
            "type": "category",
            "required": true,
            "constraints": {
                "allowed_values": [
                    "Bangalore",
                    "Chennai",
                    "Delhi",
                    "Hyderabad",
                    "Mumbai",
                    "Pune"
                ]
            }
        },
        {
            "name": "insurance_provider",
            "type": "category",
            "required": true,
            "constraints": {
                "allowed_values": [
                    "CareOne",
                    "HealthPlus",
                    "MediCareX",
                    "SecureLife"
                ]
            }
        },
        {
            "name": "chronic_flag",
            "type": "int8",
            "required": true,
            "constraints": {
                "allowed_values": [
                    0,
                    1
                ]
            }
        },
        {
            "name": "department",
            "type": "category",
            "required": true,
            "constraints": {
                "allowed_values": [
                    "Cardiology",
                    "ER",
                    "General",
                    "ICU",
                    "Neurology",
                    "Orthopedics"
                ]
            }
        },
        {
            "name": "visit_type",
            "type": "category",
            "required": true,
            "constraints": {
                "allowed_values": [
                    "ER",
                    "ICU",
                    "OPD"
                ]
            }
        },
        {
            "name": "length_of_stay_hours",
            "type": "float32",
            "required": true,
            "constraints": {
                "min_value": 0.0,
                "max_value": 720.0
            }
        },
        {
            "name": "billed_amount",
            "type": "float32",
            "required": true,
            "constraints": {
                "min_value": 0.0,
                "max_value": 1000000.0
            }
        },
        {
            "name": "payment_days",
            "type": "float32",
            "required": true,
            "constraints": {
                "min_value": 0.0,
                "max_value": 365.0
            }
        },
        {
            "name": "visit_frequency",
            "type": "int8",
            "required": true,
            "constraints": {
                "min_value": 1,
                "max_value": 100
            }
        },
        {
            "name": "lag_time",
            "type": "int32",
            "required": true,
            "constraints": {
                "min_value": -365,
                "max_value": 365
            }
        }
    ]
}